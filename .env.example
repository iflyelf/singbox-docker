# sing-box 订阅配置
# 将本文件复制为 .env 并填入你的订阅地址

# 订阅源 1
SUBSCRIPTION_URL_1='https://your-subscription-url-1'
SUBSCRIPTION_TAG_1='airport1'
SUBSCRIPTION_ENABLED_1='true'

# 订阅源 2
#SUBSCRIPTION_URL_2='https://your-subscription-url-2'
#SUBSCRIPTION_TAG_2='airport2'
#SUBSCRIPTION_ENABLED_2='true'

# 订阅源 3
#SUBSCRIPTION_URL_3='https://your-subscription-url-3'
#SUBSCRIPTION_TAG_3='airport3'
#SUBSCRIPTION_ENABLED_3='true'

# 自动更新配置
# 是否启用自动更新：true 或 false
SUBSCRIPTION_AUTO_UPDATE='true'
# 更新间隔（秒），3600 = 1 小时
SUBSCRIPTION_UPDATE_INTERVAL='3600'

# ============================================================
# 入站监听配置（可选，不设置则使用模板默认值）
# 分别对应模板里 type=mixed / socks / tproxy 的入站
# ============================================================
# mixed 入站（HTTP + SOCKS 混合代理）监听地址与端口
#MIXED_LISTEN='::'
#MIXED_PORT='7890'
# socks 入站监听地址与端口
#SOCKS_LISTEN='::'
#SOCKS_PORT='7891'
# tproxy 入站（透明代理）监听地址与端口
#TPROXY_LISTEN='::'
#TPROXY_PORT='7893'

# ============================================================
# Clash API 配置（experimental.clash_api，可选）
# ============================================================
# 外部控制器监听地址（host:port），用于 Clash 面板连接
#CLASH_API_EXTERNAL_CONTROLLER='0.0.0.0:9090'
# 访问密码（secret）
#CLASH_API_SECRET='your-secret'

# ============================================================
# API 服务配置（services 中 type=api，可选）
# ============================================================
# 监听地址
#API_SERVICE_LISTEN='0.0.0.0'
# 监听端口
#API_SERVICE_PORT='9191'
# 访问密码
#API_SERVICE_SECRET='your-secret'

# ============================================================
# 出站 routing_mark（可选）
# 覆盖所有已含 routing_mark 字段的出站（如 direct），用于策略路由打标
# ============================================================
#ROUTING_MARK='100'
